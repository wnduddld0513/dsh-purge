{
  "name": "dsh-purge",
  "version": "1.1.78",
  "description": "DeepSeek Harness 탈옥: 모든 모델을 탈옥시킬 수 있고, 모델마다 다른 프롬프트를 쓸 수 있습니다. 기본 프롬프트는 Little Code Sauce을 대상으로 합니다. Jailbreak for every model — swap prompts per model. Star 로 즐겨찾기 ⭐ 재배포하려면 저작자 표시 요구 사항 부분을 확인하세요",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.ko-KR.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "사이버 보안",
    "레드팀 평가",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuJunZhiXue/dsh-purge.git"
  },
  "homepage": "https://github.com/YuJunZhiXue/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/YuJunZhiXue/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/YuJunZhiXue/dsh-purge/tar.gz/refs/heads/master",
      "zip": "https://codeload.github.com/YuJunZhiXue/dsh-purge/zip/refs/heads/master",
      "git": "https://github.com/YuJunZhiXue/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2"
}
